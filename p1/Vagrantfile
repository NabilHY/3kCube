SERVER_IP   = "192.168.56.110"
AGENT_IP    = "192.168.56.111"
SERVER_HOST = "member1S"
AGENT_HOST  = "member2SW"


Vagrant.configure("2") do |config|
  config.vm.box = "generic/alpine319"
  config.vm.box_check_update = false

  # --- Server Node ---
  config.vm.define SERVER_HOST do |server|
    server.vm.hostname = SERVER_HOST
    server.vm.network "private_network", ip: SERVER_IP

    server.vm.synced_folder ".", "/vagrant", type: "rsync"

    server.vm.provider :libvirt do |lv|
      lv.uri    = "qemu:///system"
      lv.cpus   = 2
      lv.memory = 1024
      lv.name = SERVER_HOST
    end
    #1. Base Dependencies (Run First)
    server.vm.provision "install_deps", type: "shell", path: "scripts/deps.sh"
    server.vm.provision "setup_modules", type: "shell", path: "scripts/kernel-modules.sh"
    server.vm.provision "install_server_k3s",  type: "shell", path: "scripts/server.sh", env: {
      "SERVER_IP" => SERVER_IP,
      "SERVER_HOST" => SERVER_HOST
    }
  end

  # --- Agent/Worker Node ---
  config.vm.define AGENT_HOST do |agent|
    agent.vm.hostname = AGENT_HOST
    agent.vm.network "private_network", ip: AGENT_IP

    agent.vm.synced_folder ".", "/vagrant", type: "rsync"

    agent.vm.provider :libvirt do |lv|
      lv.uri    = "qemu:///system"
      lv.cpus   = 1
      lv.memory = 512
      lv.name = AGENT_HOST
    end

    agent.vm.provision "install_deps", type: "shell", path: "scripts/deps.sh"
    agent.vm.provision "setup_modules", type: "shell", path: "scripts/kernel-modules.sh"
    agent.vm.provision "install_agent_k3s", type: "shell", path: "scripts/agent.sh", run: "never", env: {
      "SERVER_IP" => SERVER_IP,
      "AGENT_IP" => AGENT_IP,
      "AGENT_HOST" => AGENT_HOST
    }
  end
end
